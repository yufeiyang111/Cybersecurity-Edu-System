# CyberGuard secure local configuration example
APP_ENV=development
DEBUG=false
TESTING=false
SECRET_KEY=change-this-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-this-password
MYSQL_DATABASE=cyberguard
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_API_BASE=https://api.minimaxi.com/v1
# Fernet key for user-managed LLM API keys. Generate with: Fernet.generate_key().decode()
LLM_PROVIDER_ENCRYPTION_KEY=
# Comma-separated private/provider hosts allowed for HTTP or private network endpoints.
LLM_PROVIDER_ALLOWED_HOSTS=
LLM_PROVIDER_CONNECT_TIMEOUT_SECONDS=5
LLM_PROVIDER_READ_TIMEOUT_SECONDS=60
LLM_PROVIDER_MAX_RESPONSE_BYTES=2097152
VECTOR_TOP_K=10
SIMILARITY_THRESHOLD=0.5
MAX_CONTEXT_LENGTH=4000
GRAPH_MAX_HOPS=3
GRAPH_WEIGHT_DECAY=0.8
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-this-password
NEO4J_DATABASE=neo4j
SECBERT_MODEL=shibing624/text2vec-base-chinese
# Embedding model (local path or HF id). bge-m3 常驻内存约 1.8GB，
# 系统剩余可用内存低于 EMBEDDING_MIN_FREE_MEMORY_MB 时跳过主模型，
# 自动回退到 EMBEDDING_FALLBACK_MODEL（轻量模型，约 390MB）。
# 低配服务器（如 2 核 2GB）建议直接把 EMBEDDING_MODEL 指向轻量模型。
EMBEDDING_MODEL=D:/rag-medical/models/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_MAX_LENGTH=4096
EMBEDDING_MIN_FREE_MEMORY_MB=4096
# 轻量备选模型：主模型因内存不足/加载失败时回退使用；
# 维度与主模型不同时检索自动走 BM25 词法，该模型仅用于语义重排
EMBEDDING_FALLBACK_MODEL=shibing624/text2vec-base-chinese
EMBEDDING_FALLBACK_MIN_FREE_MEMORY_MB=1500
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
HF_ENDPOINT=https://hf-mirror.com
RERANK_TOP_K=5
VECTOR_WEIGHT=0.7
GRAPH_WEIGHT=0.3
UPLOAD_FOLDER=./data/uploads
LOG_LEVEL=INFO
LOG_FILE=./data/logs/app.log
CORS_ALLOWED_ORIGINS=http://localhost:5173
SECURITY_WORKSPACE_ROOT=./data/workspaces
# Async task queue. RQ_ASYNC=true moves scans and agent runs to a separate
# worker process (start-worker.bat / `flask --app run rq-worker`), so the API
# threads never block on long-running work. Requires a running Redis beyond
# the REDIS_URL below. Keep false for a single-process local/demo setup.
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=cyberguard-security
RQ_ASYNC=false

# Agent plan execution: synchronous (tests), background (in-process thread),
# or rq (same RQ queue, recommended when RQ_ASYNC=true).
# AGENT_RUN_EXECUTOR=rq

# ---- Agent Loop v2 feature flags (T12) ----
# 默认全部关闭：关闭时新建 Run 走 v1 Runner；灰度时按需开启。
# AGENT_LOOP_V2_ENABLED=false
# AGENT_EVENT_SCHEMA_V2_ENABLED=false
# AGENT_TIMELINE_V2_ENABLED=false
# AGENT_LOOP_LEASE_SECONDS=60
SCAN_TASK_MAX_RETRIES=3
SECURITY_RATE_LIMIT_PER_MINUTE=60
SECURITY_EXPENSIVE_RATE_LIMIT_PER_MINUTE=10
ARCHIVE_MAX_UPLOAD_BYTES=52428800
ARCHIVE_MAX_EXTRACT_BYTES=524288000
ARCHIVE_MAX_FILES=20000
ARCHIVE_MAX_DEPTH=10
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Vector store backend: qdrant (default) or chroma
VECTOR_BACKEND=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_PATH=./data/qdrant_db

# OAuth 第三方登录（Google / GitHub）。后端与前端地址需与你在 Google/GitHub 上注册的回调地址一致。
OAUTH_BACKEND_BASE_URL=http://localhost:5001
OAUTH_FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public GitHub archive import: only https://github.com/{owner}/{repo}; no private repositories.
GITHUB_API_TIMEOUT_SECONDS=15
GITHUB_MAX_REDIRECTS=1

# Software composition analysis (OSV). Disabled by default; only package ecosystem/name/version are sent, and SCA_MAX_DEPENDENCIES is a hard total-query cap.
SCA_OSV_ENABLED=false
SCA_OSV_API_URL=https://api.osv.dev/v1/querybatch
SCA_REQUEST_TIMEOUT_SECONDS=15
SCA_CACHE_TTL_SECONDS=86400
SCA_MAX_DEPENDENCIES=10000

# Phase 4: task reliability and runtime health
# /api/health/ready checks database and workspace storage without live probing optional services.

# Phase 3: governed security knowledge and trusted remediation Agent
SECURITY_KNOWLEDGE_VECTOR_ENABLED=false
REMEDIATION_LLM_ENABLED=false
# Optional JSON object overriding deterministic risk-scoring weights and thresholds
SECURITY_RISK_POLICY=
REMEDIATION_MAX_CONTEXT_CHARS=12000
REMEDIATION_MAX_OUTPUT_CHARS=8000
REMEDIATION_RETRIEVAL_TOP_K=5
REMEDIATION_PATCH_MAX_LINES=500
REMEDIATION_PATCH_MAX_CHARS=50000

# ---- SiliconFlow API (free BAAI/bge-m3 + bge-reranker-v2-m3) ----
# https://cloud.siliconflow.cn 注册获取 API Key
SILICONFLOW_API_KEY=
# embedding: 置 true 后使用硅基流动免费 bge-m3（1024维，与本地模型同维，库无需重建）
EMBEDDING_API_ENABLED=false
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_MODEL=BAAI/bge-m3
# rerank: 置 true 后毫秒级 API 重排（无需 GPU，自动生效）
RERANKER_API_ENABLED=false
RERANKER_API_BASE=https://api.siliconflow.cn/v1
RERANKER_API_MODEL=BAAI/bge-reranker-v2-m3
